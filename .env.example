# Environment variables template — copy to .env and fill in your values

# ── Trading Mode ──────────────────────────────────────────────────────────────
TRADING_MODE=paper          # paper or live
BINANCE_TESTNET=true

# ── Exchange API Keys ─────────────────────────────────────────────────────────
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./trading.db
# For TimescaleDB (Docker):
# DATABASE_URL=postgresql+asyncpg://trader:password@localhost:5432/trading

# ── Cache ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Alerts ────────────────────────────────────────────────────────────────────
ALERT_CHANNEL=console       # console, telegram, discord
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK=

# ── Optional Data APIs ────────────────────────────────────────────────────────
GLASSNODE_API_KEY=
CRYPTOQUANT_API_KEY=
CRYPTOPANIC_API_KEY=

# ── LLM ───────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
